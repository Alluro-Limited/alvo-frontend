{
  "name": "alvo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:website": "bun --filter @alvo/website dev",
    "dev:admin": "bun --filter @alvo/admin dev",
    "dev:business": "bun --filter @alvo/business dev",
    "dev:courier": "bun --filter @alvo/courier-pwa dev",
    "dev:user": "bun --filter @alvo/user-pwa dev",
    "build:website": "bun --filter @alvo/website build",
    "lint": "oxlint --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "test": "vitest",
    "test:ci": "vitest run --reporter=verbose --bail=1",
    "test:coverage": "vitest --coverage",
    "test:ct": "playwright test -c playwright-ct.config.ts",
    "react-doctor": "react-doctor -y --verbose",
    "stryker": "stryker run"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "20.11.2",
    "lefthook": "^2.1.10",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.63.0",
    "oxlint": "~1.79.0",
    "playwright": "^1.62.1",
    "react-doctor": "^0.9.12",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.11"
}
