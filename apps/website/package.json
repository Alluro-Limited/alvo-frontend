{
  "name": "@alvo/website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fumadocs-mdx && bun run copy:blog-assets && vite",
    "build": "fumadocs-mdx && bun run copy:blog-assets && vite build",
    "build:vercel": "bun run build && cp dist/client/_shell.html dist/client/index.html",
    "preview": "bun run build && vite preview",
    "copy:blog-assets": "bun scripts/copy-blog-assets.ts",
    "generate": "fumadocs-mdx",
    "lint": "oxlint --max-warnings=0 --no-error-on-unmatched-pattern",
    "format": "oxfmt"
  },
  "dependencies": {
    "@alvo/design-tokens": "workspace:*",
    "@alvo/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-start": "^1.168.46",
    "fumadocs-core": "^16.15.9",
    "fumadocs-mdx": "^15.4.0",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.63.0",
    "oxlint": "~1.79.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~7.0.2",
    "vite": "^8.2.1"
  }
}
